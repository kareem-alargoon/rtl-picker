# SECURITY: private signing key for a packed .crx. Anyone holding this can ship
# updates that impersonate your extension. Never commit it, never publish it.
*.pem

# Packed extension output — the Chrome Web Store takes a .zip, not a .crx
*.crx
*.zip
dist/

# Build intermediates (regenerated by tools/build-exe.ps1)
desktop/src/*.ico

# Local editor / agent configuration
.claude/settings.local.json

# Windows noise
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Local dev tooling - build, packaging, icon generation and end-to-end tests.
# Kept out of the public repo; the README documents the equivalent one-liners.
tools/
